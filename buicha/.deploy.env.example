# deploy.sh 用の設定例。.deploy.env にコピーして編集する（.deploy.env は gitignore 済み）。

# 必須: デプロイ先ホストとユーザー
TARGET_HOST=server.example.com
TARGET_USER=deploy

# SSH ポート（既定 22）
SSH_PORT=22

# SSH 秘密鍵のパス。空なら -i を付けない
SSH_KEY=

# ssh/scp の接続元に固定するネットワークインターフェース名。空なら付けない
BIND_IFACE=

# リモートの compose ファイル（スペース区切り。image 書き換え対象の案内に使う）
REMOTE_COMPOSE_FILES="/path/to/compose.yaml"

# docker compose のプロジェクト名
COMPOSE_PROJECT=misskey

# `docker compose up` の案内で -f に渡す compose ファイル
COMPOSE_FILE_FOR_UP=/path/to/compose.yaml
